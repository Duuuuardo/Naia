{
  "name": "naia",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "campaigns/apps/*",
    "campaigns/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "dev:campaigns": "turbo run dev --filter='./campaigns/*/*'",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "jose": "6.2.3",
    "turbo": "2.10.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "seroval": "^1.6.9",
    "sharp": "0.35.5",
    "ip-address": "^10.7.3",
    "source-map-js": "^1.2.2",
    "js-yaml": "^4.3.1",
    "browserslist": "^4.29.3",
    "nanoid": "^3.3.18"
  }
}
