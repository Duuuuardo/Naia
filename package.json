{
  "name": "naia",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "campaigns/apps/*",
    "campaigns/packages/*",
    "crm/apps/*",
    "crm/packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "dev:campaigns": "turbo run dev --filter='./campaigns/*/*'",
    "dev:crm": "turbo run dev --filter='./crm/*/*'",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "jose": "^6",
    "turbo": "latest",
    "typescript": "^5"
  }
}
