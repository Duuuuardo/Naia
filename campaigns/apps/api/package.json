{
  "name": "@naia/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot --env-file ../../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file ../../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1",
    "@elysiajs/swagger": "^1",
    "@naia/db": "workspace:*",
    "@naia/entitlements": "workspace:*",
    "@naia/queue": "workspace:*",
    "@naia/scheduling": "workspace:*",
    "@naia/schemas": "workspace:*",
    "@naia/session-host-client": "workspace:*",
    "@naia/storage": "workspace:*",
    "@naia/vianova-auth": "workspace:*",
    "@naia/vianova-config": "workspace:*",
    "@naia/vianova-email": "workspace:*",
    "drizzle-orm": "^0.44",
    "elysia": "^1",
    "logixlysia": "^6.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@naia/config": "workspace:*",
    "bun-types": "1.3.14",
    "typescript": "^5"
  }
}
