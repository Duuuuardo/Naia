{
  "name": "@naia/session-host",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot --env-file ../../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file ../../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1",
    "@naia/db": "workspace:*",
    "@naia/queue": "workspace:*",
    "@naia/schemas": "workspace:*",
    "@naia/storage": "workspace:*",
    "@whiskeysockets/baileys": "latest",
    "drizzle-orm": "^0.44",
    "elysia": "^1",
    "logixlysia": "^6.6.0",
    "teleproto": "^1.228.2"
  },
  "devDependencies": {
    "@naia/config": "workspace:*",
    "bun-types": "latest",
    "typescript": "^5"
  }
}
