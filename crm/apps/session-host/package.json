{
  "name": "@crm/session-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file ../../../.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file ../../../.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crm/db": "workspace:*",
    "@crm/events": "workspace:*",
    "@crm/queue": "workspace:*",
    "@crm/schemas": "workspace:*",
    "@crm/storage": "workspace:*",
    "@naia/channel-core": "1.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1",
    "grammy": "^1",
    "logixlysia": "^6.6.0"
  },
  "devDependencies": {
    "@naia/config": "workspace:*",
    "bun-types": "1.3.14",
    "typescript": "^5"
  }
}
