# Banco (docker-compose deste repo expõe na 5435)
NAIA_DATABASE_URL=postgres://naia:naia_secret@localhost:5435/naia

# Redis (filas de disparo — docker-compose deste repo expõe na 6381)
NAIA_REDIS_URL=redis://localhost:6381

# URLs do próprio Naia
NAIA_API_URL=http://localhost:4001
NAIA_WEB_URL=http://localhost:3001
# Porta do vite dev server do apps/web (mude junto com NAIA_WEB_URL se 3001 estiver ocupada)
# NAIA_WEB_PORT=3001

# Session host (WhatsApp/Telegram sockets)
SESSION_HOST_BASE_URL=http://localhost:4010
SESSION_HOST_SCALE_URL=http://localhost:4011
# HOST_ID=base   # usado apenas pelo processo session-host
NAIA_INTERNAL_SECRET=change-me-internal-secret

# Vianova (Identity Provider + billing + config server) — client OIDC "naia" já registrado no
# seed do vianova (packages/db/src/seed.ts)
VIANOVA_API_URL=http://localhost:5000
VIANOVA_WEB_URL=http://localhost:3000
VIANOVA_CONFIG_SERVER_URL=http://localhost:5100
NAIA_OIDC_CLIENT_ID=naia
NAIA_OIDC_CLIENT_SECRET=naia-dev-secret

# Segredo usado pelo Naia para chamar rotas internas do Vianova (ex: /internal/files/*).
# Deve bater com VIANOVA_INTERNAL_SECRET configurado no Vianova.
VIANOVA_INTERNAL_SECRET=vianova-internal-secret

# Segredo para o Vianova emitir token de serviço e chamar POST /internal/entitlements
# e POST /internal/session-revoked neste repo (deve bater com o que o vianova usa
# para chamar este produto — validado via JWKS do Vianova, não é um secret próprio
# do Naia, mas fica documentado aqui pra referência local)

# Telegram
# (nenhum segredo global — token do bot é por conexão, informado pelo usuário)

# WhatsApp (Baileys)
WHATSAPP_VERIFY_TOKEN=change-me-whatsapp-verify
