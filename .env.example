# Naia (Campaigns + CRM + landing) — Variáveis de ambiente de desenvolvimento
#
# Copie este arquivo para .env e preencha os segredos.
# Valores default abaixo são APENAS para dev local (localhost).
# Em produção use senhas fortes e um secrets manager.

# ─── Bancos de dados ───
# Campaigns (Postgres na porta 5435) e CRM (Postgres na porta 5436).
NAIA_DATABASE_URL=postgres://naia:naia_secret@localhost:5435/naia
CRM_DATABASE_URL=postgres://crm:crm_secret@localhost:5436/crm

# ─── Redis ───
# Filas de disparo de campanhas. docker-compose da raiz expõe na 6381.
NAIA_REDIS_URL=redis://:naia_redis_secret@localhost:6381

# ─── URLs do próprio Naia ───
NAIA_API_URL=http://localhost:4001
NAIA_WEB_URL=http://localhost:3001

# CRM (scaffold)
CRM_API_URL=http://localhost:4002
CRM_WEB_URL=http://localhost:3302

# ─── Session host (WhatsApp/Telegram sockets) ───
SESSION_HOST_BASE_URL=http://localhost:4010
SESSION_HOST_SCALE_URL=http://localhost:4011

# ─── Segredos internos ───
# Segredo usado entre apps do Naia (api, worker, session-host) para chamadas internas.
NAIA_INTERNAL_SECRET=naia-internal-secret

# Segredo usado pelo Naia para chamar rotas internas do Vianova (ex: /internal/files/*).
# Deve bater com VIANOVA_INTERNAL_SECRET configurado no Vianova.
VIANOVA_INTERNAL_SECRET=vianova-internal-secret

# ─── Vianova (Identity Provider + billing + config server) ───
# Client OIDC "naia" já registrado no seed do vianova (packages/db/src/seed.ts).
VIANOVA_API_URL=http://localhost:5000
VIANOVA_WEB_URL=http://localhost:3000
# Em dev use localhost. Em produção (mesma VPS com rede Docker compartilhada) use:
# VIANOVA_CONFIG_SERVER_URL=http://vianova-config-server:5100
VIANOVA_CONFIG_SERVER_URL=http://localhost:5100

NAIA_OIDC_CLIENT_ID=naia
NAIA_OIDC_CLIENT_SECRET=naia-dev-secret

# ─── Variáveis Vite (expõem valores para o browser) ───
# Devem repetir as URLs acima com prefixo VITE_ para que o cliente as enxergue.
VITE_NAIA_API_URL=http://localhost:4001
VITE_NAIA_WEB_URL=http://localhost:3001
VITE_VIANOVA_API_URL=http://localhost:5000
VITE_VIANOVA_WEB_URL=http://localhost:3000
VITE_CRM_WEB_URL=http://localhost:3302

# ─── Portas dos dev servers Vite ───
# Só precisam mudar se as portas padrão estiverem ocupadas.
NAIA_WEB_PORT=3001
NAIA_LANDING_PORT=3301
CRM_WEB_PORT=3302

# ─── S3 / MinIO (mídia das campanhas) ───
# O MinIO do Naia é exclusivo para mídia de campanhas (imagens, vídeos, etc.).
# docker-compose da raiz sobe em localhost:9102 (console :9103).
NAIA_S3_ENDPOINT=http://localhost:9102
NAIA_S3_BUCKET=naia-campaigns
NAIA_S3_ACCESS_KEY=naia
NAIA_S3_SECRET_KEY=naia_secret_minio

# ─── Session-host / WhatsApp / Telegram ───
# Diretório para persistir estado de sessões Baileys/tdlib. Em dev /tmp é OK.
NAIA_SESSIONS_DIR=/tmp/naia-sessions

# Host ID quando rodar o session-host manualmente (docker-compose já define base/scale).
# HOST_ID=base

# WhatsApp verify token para webhooks de status.
WHATSAPP_VERIFY_TOKEN=change-me-whatsapp-verify

# Telegram: opcional em dev. Se omitidos, algumas funcionalidades de Telegram
# não funcionam, mas o resto do produto sobe normalmente.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─── CORS e rate limiting (opcionais — têm defaults em código) ───
# NAIA_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3301
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# ─── Porta de runtime dos serviços (opcional — defaults em código) ───
# PORT=4001          # naia-api
# PORT=4002          # crm-api
# PORT=4010          # session-host

# ─── Public API URL (opcional) ───
# Usado em webhooks/automações quando o callback precisa de uma URL pública.
# Se omitido, usa NAIA_API_URL.
# NAIA_PUBLIC_API_URL=
